# ==================================================
# DHEEPTHI-AI Environment Variables Template
# ==================================================
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
# Never commit your actual .env file containing real keys.

# --------------------------------------------------
# Gemini API Keys (Key Rotation Pool)
# --------------------------------------------------
# Primary Gemini API Key (Required)
GEMINI_API_KEY_1=

# Secondary / Fallback Gemini API Keys (Optional, for quota rotation)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# --------------------------------------------------
# Gemini Models Configuration
# --------------------------------------------------
# Default Conversational Model
GEMINI_MODEL=models/gemini-3.5-flash

# Semantic Command Planner Model Hierarchy
GEMINI_PLANNER_PRIMARY_MODEL=gemini-3.8-flash
GEMINI_PLANNER_FALLBACK_1=gemini-3.7-flash
GEMINI_PLANNER_FALLBACK_2=gemini-3.6-flash

# --------------------------------------------------
# Gemini Live Voice Configuration
# --------------------------------------------------
# Gemini Live Model
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Gemini Live Voice Selection:
# Options: Aoede (recommended female), Kore, Puck, Charon, Fenrir
GEMINI_LIVE_VOICE=Aoede

# Voice Activity Detection (VAD) Sensitivity
GEMINI_LIVE_START_SENSITIVITY=START_SENSITIVITY_HIGH
GEMINI_LIVE_END_SENSITIVITY=END_SENSITIVITY_HIGH
GEMINI_LIVE_SILENCE_DURATION_MS=600

# --------------------------------------------------
# Optional Cloud Speech & Agent Keys
# --------------------------------------------------
# Groq Cloud Speech-to-Text (whisper-large-v3-turbo fallback)
GROQ_API_KEY=

# Groq Code Agent (Optional)
GROQ_API_KEY_CODE_AGENT=

# Gemini Vision API Key (Optional, for computer vision tasks)
GEMINI_VISION_API_KEY=

# --------------------------------------------------
# Debug Settings
# --------------------------------------------------
DEBUG=false
DEBUG_AUDIO_VERBOSE=false